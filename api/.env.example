# Environment variables for Go API
# Copy this file to .env and customize for your environment

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5001
SERVER_DEBUG=false

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=logdb
MONGO_COLLECTION=logs
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=100

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL=600

# Fabric
FABRIC_API_URL=http://localhost:4000
FABRIC_CHANNEL=logchannel
FABRIC_CHAINCODE=logchaincode
FABRIC_SYNC_ENABLED=true
FABRIC_TRANSPORT=docker-exec
FABRIC_PEER_CONTAINER=peer0.org1.example.com
FABRIC_ORDERER_ADDRESS=orderer.example.com:7050
FABRIC_ORDERER_TLS_CA_FILE=/opt/gopath/src/github.com/hyperledger/fabric/peer/crypto/ordererOrganizations/example.com/orderers/orderer.example.com/msp/tlscacerts/tlsca.example.com-cert.pem
FABRIC_TLS_ENABLED=true

# WAL
WAL_ENABLED=true
# backend: "file" (single instance) or "redis" (Redis Streams, multi-instance).
# For "redis", run Redis with AOF (appendfsync always) to keep zero-data-loss.
WAL_BACKEND=file
WAL_DIRECTORY=/var/log/tcc-wal
WAL_CHECK_INTERVAL=5s
WAL_STREAM_KEY=wal:pending:logs
WAL_CONSUMER_GROUP=wal-processors

# Batching
BATCHING_ENABLED=true
BATCHING_AUTO_BATCH_SIZE=100
BATCHING_AUTO_BATCH_INTERVAL=30s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Auth (protects logs/merkle/wal/stats). Enable in production.
# AUTH_API_KEYS is a comma-separated list of accepted keys.
AUTH_ENABLED=false
AUTH_HEADER_NAME=X-API-Key
AUTH_API_KEYS=

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m
